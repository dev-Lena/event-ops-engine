// Fact schema (EDB). Every fact is inserted from Python (see docs/design.md 5, 9).
// Column names avoid wirelog reserved words (min, max, count, sum).

// --- session ---------------------------------------------------------------
.decl session_capacity(session: symbol, capacity: int64)
.decl days_left(session: symbol, days: int64)
.decl now(ts: int64)

// --- registration -> attendees ----------------------------------------------
.decl registration(reg: symbol, session: symbol)
.decl attendee(reg: symbol, attendee: symbol)
.decl given_attr(attendee: symbol, dim: symbol, value: symbol)
.decl status_event(reg: symbol, ts: int64, status: symbol)
.decl unknown_party(reg: symbol, party_size: int64)

// --- attributes proposed by a normalizer (docs/design.md 14) ----------------
// `attendee_attr` is derived in capacity.dl: given directly, or promoted from a candidate
// whose confidence (0~100) reaches the dimension's threshold and whose value is allowed.
.decl candidate_attr(attendee: symbol, dim: symbol, value: symbol, confidence: int64, evidence: symbol)
.decl normalize_threshold(dim: symbol, min_pct: int64)
.decl dimension_value(dim: symbol, value: symbol)
.decl attendee_attr(attendee: symbol, dim: symbol, value: symbol)

// --- targets and policy -----------------------------------------------------
.decl target(session: symbol, dim: symbol, value: symbol, lo: int64, hi: int64)
.decl ratio_target(session: symbol, dim: symbol, value_a: symbol, value_b: symbol, max_diff: int64)
.decl policy(session: symbol, key: symbol, n: int64)
// Promotion cutoff (#52), epoch from clock.py: start time minus promotion_cutoff_hours, or,
// without a start time, the earliest moment it could be (the date's midnight minus the hours).
.decl promotion_cutoff_ts(session: symbol, ts: int64)
.decl earliest_cutoff_ts(session: symbol, ts: int64)
.decl deadline_hours(session: symbol, hours: int64)
