// Module ② capacity status. See docs/design.md 6.

// --- current status: the latest status_event wins -----------------------------
.decl latest_ts(reg: symbol, ts: int64)
.decl current_status(reg: symbol, status: symbol)
.decl confirmed(reg: symbol)
.decl pending_payment(reg: symbol)

latest_ts(R, max(T)) :- status_event(R, T, _).
current_status(R, St) :- latest_ts(R, T), status_event(R, T, St).
confirmed(R) :- current_status(R, "confirmed").
pending_payment(R) :- current_status(R, "pending_payment").

// --- attributes: given directly, or promoted from normalizer candidates -----------
// The four candidate rules are mutually exclusive so an attendee gets exactly one value
// per dimension (wirelog keeps duplicates, and `count` would see them).
attendee_attr(A, D, V) :- given_attr(A, D, V).
attendee_attr(A, D, V) :-
    candidate_attr(A, D, V, C, _), normalize_threshold(D, Min), C >= Min, dimension_value(D, V).
attendee_attr(A, D, "unknown") :-
    candidate_attr(A, D, _, C, _), normalize_threshold(D, Min), C < Min.
attendee_attr(A, D, "unknown") :-
    candidate_attr(A, D, V, C, _), normalize_threshold(D, Min), C >= Min, !dimension_value(D, V).

// --- combinations (#32): counted as dim "combo" next to the plain attributes ----------
// An attendee is in a combination when the gender matches and the age is in the range.
// Ranges of one gender never overlap (model.check_combos), so each person counts once.
.decl attendee_session(attendee: symbol, session: symbol)
.decl combo_hit(attendee: symbol, combo: symbol)
.decl counted_attr(attendee: symbol, dim: symbol, value: symbol)

attendee_session(A, S) :- attendee(R, A), registration(R, S).
combo_hit(A, C) :-
    combo_def(S, C, G, Lo, Hi), attendee_session(A, S), attendee_attr(A, "gender", G),
    attendee_age(A, Age), Age >= Lo, Age <= Hi.
counted_attr(A, D, V) :- attendee_attr(A, D, V).
counted_attr(A, "combo", C) :- combo_hit(A, C).

// --- seats: one row per attendee that occupies a seat ------------------------
.decl seat(session: symbol, attendee: symbol)
.decl pending_seat(session: symbol, attendee: symbol)

seat(S, A) :- registration(R, S), attendee(R, A), confirmed(R).
pending_seat(S, A) :- registration(R, S), attendee(R, A), pending_payment(R).

// --- whole-session headcount -------------------------------------------------
.decl session_filled_raw(session: symbol, n: int64)
.decl session_filled(session: symbol, n: int64)
.decl session_pending_raw(session: symbol, n: int64)
.decl session_pending(session: symbol, n: int64)
.decl remaining_seats(session: symbol, n: int64)
.decl session_full(session: symbol)

session_filled_raw(S, count(A)) :- seat(S, A).
session_filled(S, N) :- session_capacity(S, _), session_filled_raw(S, N).
session_filled(S, 0) :- session_capacity(S, _), !session_filled_raw(S, _).
session_pending_raw(S, count(A)) :- pending_seat(S, A).
session_pending(S, N) :- session_capacity(S, _), session_pending_raw(S, N).
session_pending(S, 0) :- session_capacity(S, _), !session_pending_raw(S, _).
// A seat awaiting payment is taken too (operator rule: remaining = capacity - confirmed - pending).
remaining_seats(S, Cap - F - P) :- session_capacity(S, Cap), session_filled(S, F), session_pending(S, P).
session_full(S) :- remaining_seats(S, R), R <= 0.

// --- per-attribute headcount against targets --------------------------------
.decl tracked(session: symbol, dim: symbol, value: symbol)
.decl filled_raw(session: symbol, dim: symbol, value: symbol, n: int64)
.decl filled(session: symbol, dim: symbol, value: symbol, n: int64)
.decl pending_raw(session: symbol, dim: symbol, value: symbol, n: int64)
.decl pending(session: symbol, dim: symbol, value: symbol, n: int64)
.decl remaining(session: symbol, dim: symbol, value: symbol, n: int64)
.decl gap(session: symbol, dim: symbol, value: symbol, n: int64)
.decl full(session: symbol, dim: symbol, value: symbol)
.decl over_capacity(session: symbol, dim: symbol, value: symbol, n: int64)
.decl imbalance(session: symbol, dim: symbol, short_value: symbol, diff: int64)

tracked(S, D, V) :- target(S, D, V, _, _).
tracked(S, D, V) :- ratio_target(S, D, V, _, _).
tracked(S, D, V) :- ratio_target(S, D, _, V, _).

filled_raw(S, D, V, count(A)) :- seat(S, A), counted_attr(A, D, V).
filled(S, D, V, N) :- tracked(S, D, V), filled_raw(S, D, V, N).
filled(S, D, V, 0) :- tracked(S, D, V), !filled_raw(S, D, V, _).

pending_raw(S, D, V, count(A)) :- pending_seat(S, A), counted_attr(A, D, V).
pending(S, D, V, N) :- tracked(S, D, V), pending_raw(S, D, V, N).
pending(S, D, V, 0) :- tracked(S, D, V), !pending_raw(S, D, V, _).

remaining(S, D, V, Hi - F - P) :- target(S, D, V, _, Hi), filled(S, D, V, F), pending(S, D, V, P).
gap(S, D, V, Lo - F - P) :- target(S, D, V, Lo, _), filled(S, D, V, F), pending(S, D, V, P), Lo - F - P > 0.
full(S, D, V) :- remaining(S, D, V, R), R <= 0.
over_capacity(S, D, V, F - Hi) :- target(S, D, V, _, Hi), filled(S, D, V, F), F > Hi.

imbalance(S, D, B, Fa - Fb) :- ratio_target(S, D, A, B, Max), filled(S, D, A, Fa), filled(S, D, B, Fb), Fa - Fb > Max.
imbalance(S, D, A, Fb - Fa) :- ratio_target(S, D, A, B, Max), filled(S, D, A, Fa), filled(S, D, B, Fb), Fb - Fa > Max.

// --- registrations an operator must look at ----------------------------------
// Only registrations that occupy a seat (confirmed or waiting for payment) matter.
.decl occupies(reg: symbol)
.decl needs_review(session: symbol, reg: symbol, reason: symbol)
occupies(R) :- confirmed(R).
occupies(R) :- pending_payment(R).
needs_review(S, R, "unknown_party") :- registration(R, S), occupies(R), unknown_party(R, _).
needs_review(S, R, "low_confidence") :-
    registration(R, S), occupies(R), attendee(R, A),
    candidate_attr(A, D, _, C, _), normalize_threshold(D, Min), C < Min.
needs_review(S, R, "missing_birth_year") :-
    registration(R, S), occupies(R), attendee(R, A), age_missing(A).
needs_review(S, R, "unknown_value") :-
    registration(R, S), occupies(R), attendee(R, A),
    candidate_attr(A, D, V, C, _), normalize_threshold(D, Min), C >= Min, !dimension_value(D, V).

// --- ages per gender for "similar age" (#91) ------------------------------------
// Two pools: "occupying" (confirmed or waiting for payment) is who will be in the room,
// "applied" is who the person in charge still picks from. Attendees without a birth year
// are counted apart so a shorter list never goes unexplained. No rule here names a person.
.decl applied(reg: symbol)
.decl age_pool(reg: symbol, pool: symbol)
.decl age_entry(session: symbol, gender: symbol, pool: symbol, attendee: symbol, age: int64)
.decl age_low(session: symbol, gender: symbol, pool: symbol, age: int64)
.decl age_high(session: symbol, gender: symbol, pool: symbol, age: int64)
.decl age_spread(session: symbol, gender: symbol, pool: symbol, years: int64)
.decl age_unknown(session: symbol, gender: symbol, pool: symbol, attendee: symbol)
.decl age_unknown_count(session: symbol, gender: symbol, pool: symbol, n: int64)

applied(R) :- current_status(R, "applied").
age_pool(R, "occupying") :- occupies(R).
age_pool(R, "applied") :- applied(R).
age_entry(S, G, P, A, Age) :-
    similar_age(S), registration(R, S), age_pool(R, P), attendee(R, A),
    attendee_attr(A, "gender", G), attendee_age(A, Age).
age_low(S, G, P, min(Age)) :- age_entry(S, G, P, _, Age).
age_high(S, G, P, max(Age)) :- age_entry(S, G, P, _, Age).
age_spread(S, G, P, Hi - Lo) :- age_high(S, G, P, Hi), age_low(S, G, P, Lo).
age_unknown(S, G, P, A) :-
    similar_age(S), registration(R, S), age_pool(R, P), attendee(R, A),
    attendee_attr(A, "gender", G), age_missing(A).
age_unknown_count(S, G, P, count(A)) :- age_unknown(S, G, P, A).

// --- spread review (#91 B) --------------------------------------------------------
// A gender's seat holders are further apart than the event allows ("within N years", so
// equal is fine). Keyed by session and gender, never by registration: whoever widened the
// spread is not named. Sign-ups not yet picked don't count; past sessions are left alone.
.decl age_spread_review(session: symbol, gender: symbol, spread: int64, allowed: int64)
age_spread_review(S, G, N, L) :-
    age_spread(S, G, "occupying", N), age_spread_limit(S, L), N > L, days_left(S, D), D >= 0.
