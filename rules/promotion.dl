// Module ③ promotion judgement. Recommends only; people execute. See docs/design.md 7.

.decl active(session: symbol)
.decl confirmed_at(reg: symbol, ts: int64)
.decl recent_seat(session: symbol, attendee: symbol)
.decl recent_raw(session: symbol, dim: symbol, value: symbol, n: int64)
.decl recent(session: symbol, dim: symbol, value: symbol, n: int64)
.decl promote(session: symbol, dim: symbol, value: symbol, need: int64, reason: symbol)
.decl blocked(session: symbol, dim: symbol, value: symbol, need: int64, reason: symbol)
.decl cap(session: symbol, dim: symbol, value: symbol, limit: int64, other: symbol, other_filled: int64, max_diff: int64)
.decl capped(session: symbol, dim: symbol, value: symbol)
.decl past_cutoff(session: symbol)
.decl cutoff_unknown(session: symbol)

active(S) :- days_left(S, Days), Days >= 0.

// Promotion stops promotion_cutoff_hours before the start, inclusive (#52, confirmed). Only
// `promote` stops: `blocked` and `cap` keep following `active`, which is date level.
past_cutoff(S) :- promotion_cutoff_ts(S, T), now(N), N >= T, active(S).
// No start time: the cutoff cannot be applied, so flag recommendations once it may have passed.
cutoff_unknown(S) :- earliest_cutoff_ts(S, T), now(N), N >= T, active(S).

// Confirmations in the last 7 days (604800 s) before `now`. glossary "도메인 경계 규칙".
confirmed_at(R, T) :- latest_ts(R, T), status_event(R, T, "confirmed").
recent_seat(S, A) :- registration(R, S), attendee(R, A), confirmed_at(R, T), now(N), T + 604800 > N.
recent_raw(S, D, V, count(A)) :- recent_seat(S, A), counted_attr(A, D, V).
recent(S, D, V, N) :- tracked(S, D, V), recent_raw(S, D, V, N).
recent(S, D, V, 0) :- tracked(S, D, V), !recent_raw(S, D, V, _).

// A value under a temporary cap (below) is never promoted: it must wait for its partner.
promote(S, D, V, G, "lead_time") :- gap(S, D, V, G), active(S), !session_full(S), !capped(S, D, V), !held(S, D, V), !past_cutoff(S), days_left(S, Days), policy(S, "lead_days", L), Days <= L.
promote(S, D, V, G, "slow_trend") :- gap(S, D, V, G), active(S), !session_full(S), !capped(S, D, V), !held(S, D, V), !past_cutoff(S), recent(S, D, V, N), policy(S, "trend_min_per_week", M), N < M.
promote(S, D, V, Diff, "imbalance") :- imbalance(S, D, V, Diff), active(S), !session_full(S), !capped(S, D, V), !held(S, D, V), !past_cutoff(S).

blocked(S, D, V, G, "session_full") :- gap(S, D, V, G), active(S), session_full(S).
blocked(S, D, V, Diff, "session_full") :- imbalance(S, D, V, Diff), active(S), session_full(S).

// --- temporary cap for the leading side of a ratio (#51) ---------------------------
// When one value runs ahead of its ratio partner by more than max_diff, recommend holding
// it at (partner's confirmed + max_diff) until the partner catches up. The operator does
// this by hand today (closing one gender in the form). Recommendation only, like promote.
cap(S, D, A, Fb + Max, B, Fb, Max) :-
    ratio_target(S, D, A, B, Max), filled(S, D, A, Fa), filled(S, D, B, Fb),
    Fa - Fb > Max, active(S), !session_full(S).
cap(S, D, B, Fa + Max, A, Fa, Max) :-
    ratio_target(S, D, A, B, Max), filled(S, D, A, Fa), filled(S, D, B, Fb),
    Fb - Fa > Max, active(S), !session_full(S).
capped(S, D, V) :- cap(S, D, V, _, _, _, _).

// --- combinations (#32): when their gender can't take the people they need -------------
// A gender's combinations go quiet while the gender is capped (the cap explains why), and
// are held when their shortfalls add up to more than the gender's room: the room left
// under the gender's target, or the session's when the gender has none. Promotion can't
// meet those targets together, so the operator decides (like `session_full`).
.decl combo_gender(session: symbol, combo: symbol, gender: symbol)
.decl combo_gap_sum(session: symbol, gender: symbol, n: int64)
.decl gender_room(session: symbol, gender: symbol, n: int64)
.decl combo_conflict(session: symbol, gender: symbol)
.decl held(session: symbol, dim: symbol, value: symbol)

combo_gender(S, C, G) :- combo_def(S, C, G, _, _).
combo_gap_sum(S, G, sum(N)) :- gap(S, "combo", C, N), combo_gender(S, C, G).
gender_room(S, G, R) :- combo_gap_sum(S, G, _), remaining(S, "gender", G, R).
gender_room(S, G, R) :- combo_gap_sum(S, G, _), !target(S, "gender", G, _, _), remaining_seats(S, R).
combo_conflict(S, G) :- combo_gap_sum(S, G, N), gender_room(S, G, R), N > R.
held(S, "combo", C) :- combo_gender(S, C, G), cap(S, "gender", G, _, _, _, _).
held(S, "combo", C) :- combo_gender(S, C, G), combo_conflict(S, G).
blocked(S, "combo", C, N, "gender_room") :-
    gap(S, "combo", C, N), combo_gender(S, C, G), combo_conflict(S, G), active(S), !session_full(S).
