// Module ① inquiry triage: the generic contract. Type rules (#15-#21) derive `cause` and
// `needs`; this file only fixes the schema and `in_scope`. See docs/design.md 13.

// --- input facts (ADAPT, facts.py) --------------------------------------------
.decl question(q: symbol)
.decl supported_topic(topic: symbol)
.decl log_event(id: symbol, reg: symbol, kind: symbol, ts: int64)
.decl log_attr(id: symbol, attr: symbol, value: symbol)
.decl triage_policy(key: symbol, n: int64)

// --- candidate facts proposed by the interpreter (validated in harness.py) ---------
.decl asks_about(q: symbol, topic: symbol)
.decl about_registration(q: symbol, reg: symbol)
.decl about_session(q: symbol, session: symbol)
.decl about_event(q: symbol, id: symbol)
.decl about_value(q: symbol, dim: symbol, value: symbol)

// --- derived ---------------------------------------------------------------------
.decl in_scope(q: symbol)
.decl cause(q: symbol, cause: symbol, evidence: symbol)
.decl needs(q: symbol, what: symbol)

in_scope(Q) :- asks_about(Q, T), supported_topic(T).

// --- subject of the question -------------------------------------------------------
// A question names a registration directly or through one of its log events.
// `asks(q, reg, topic)` is the prefix every type rule starts from.
.decl subject(q: symbol, reg: symbol)
.decl asks(q: symbol, reg: symbol, topic: symbol)
subject(Q, R) :- about_registration(Q, R).
subject(Q, R) :- about_event(Q, E), log_event(E, R, _, _), R != "".
asks(Q, R, T) :- subject(Q, R), asks_about(Q, T).

// An event of a kind that the same registration has a newer event of. Type rules compare
// the latest issue with the latest entry and ignore superseded ones.
.decl superseded(id: symbol)
superseded(E) :- log_event(E, R, K, T), log_event(E2, R, K, T2), E != E2, T2 > T.

// --- type 1: user input error, account number length (#15) ------------------------
// The number the applicant last typed has a different length than the account last issued
// to them. Normal: guide the applicant. Evidence: both log events.
.decl account_mismatch(q: symbol, issued: symbol, entered: symbol)
account_mismatch(Q, I, E) :-
    asks(Q, R, "payment"),
    log_event(I, R, "account_issued", _), !superseded(I), log_attr(I, "digits", DI),
    log_event(E, R, "account_entered", _), !superseded(E), log_attr(E, "digits", DE), DI != DE.
cause(Q, "user_input", I) :- account_mismatch(Q, I, _).
cause(Q, "user_input", E) :- account_mismatch(Q, _, E).
needs(Q, "account_entered") :-
    asks(Q, R, "payment"),
    log_event(_, R, "account_issued", _), !log_event(_, R, "account_entered", _).
needs(Q, "account_issued") :- asks(Q, R, "payment"), !log_event(_, R, "account_issued", _).

// --- type 2: external cause, delivery provider delay (#16) ------------------------
// Our send timed out, but the provider's receipt says delivered afterwards: the message
// went out, no resend. A resend between the two would make the receipt ambiguous, so the
// rule requires none. Evidence: the timed-out send and the receipt.
// Proof of delivery is either the provider's own receipt or the operator looking the
// message up in the provider log and finding it (`provider_lookup{result: found}`).
.decl delivered_proof(reg: symbol, proof: symbol, ts: int64)
delivered_proof(R, P, T) :- log_event(P, R, "provider_receipt", T), log_attr(P, "result", "delivered").
delivered_proof(R, P, T) :- log_event(P, R, "provider_lookup", T), log_attr(P, "result", "found").
.decl resent_between(sent: symbol, proof: symbol)
resent_between(S, P) :-
    log_event(S, R, "message_sent", TS), delivered_proof(R, P, TP),
    log_event(S2, R, "message_sent", T2), S2 != S, T2 > TS, T2 <= TP.
.decl delivered_late(q: symbol, sent: symbol, receipt: symbol)
delivered_late(Q, S, P) :-
    asks(Q, R, "delivery"),
    log_event(S, R, "message_sent", TS), log_attr(S, "result", "timeout"),
    delivered_proof(R, P, TP), TP >= TS,
    !resent_between(S, P).
cause(Q, "external_delay", S) :- delivered_late(Q, S, _).
cause(Q, "external_delay", P) :- delivered_late(Q, _, P).

// --- type 2b: external failure, the provider never got the request (#47) ----------
// The send timed out and the provider log has no record at all: the message did not go
// out, resend. (Ops guideline: no record in the provider log → resend.)
// A proof that came after this send; older proofs belong to earlier messages.
.decl proof_after(sent: symbol)
proof_after(S) :- log_event(S, R, "message_sent", TS), delivered_proof(R, _, TP), TP >= TS.
.decl unreachable(q: symbol, sent: symbol, lookup: symbol)
unreachable(Q, S, L) :-
    asks(Q, R, "delivery"),
    log_event(S, R, "message_sent", TS), log_attr(S, "result", "timeout"),
    log_event(L, R, "provider_lookup", TL), log_attr(L, "result", "none"), TL >= TS,
    !proof_after(S).
cause(Q, "external_failure", S) :- unreachable(Q, S, _).
cause(Q, "external_failure", L) :- unreachable(Q, _, L).
// Neither a receipt nor a lookup yet: the provider log must be checked first.
needs(Q, "provider_lookup") :-
    asks(Q, R, "delivery"),
    log_event(S, R, "message_sent", _), log_attr(S, "result", "timeout"),
    !log_event(_, R, "provider_receipt", _), !log_event(_, R, "provider_lookup", _).

// --- type 3: allowed by policy, duplicate re-registration (#18) --------------------
// Two registrations for the same session carry the same participant key: policy allows
// it (the operator only marks the duplicate). Evidence: both submission events.
.decl same_participant(reg: symbol, submitted: symbol, other_submitted: symbol)
same_participant(R, E, E2) :-
    registration(R, S), registration(R2, S), R != R2,
    log_event(E, R, "registration_submitted", _), log_attr(E, "participant", P),
    log_event(E2, R2, "registration_submitted", _), log_attr(E2, "participant", P).
cause(Q, "policy_normal", E) :- asks(Q, R, "duplicate"), same_participant(R, E, _).
cause(Q, "policy_normal", E2) :- asks(Q, R, "duplicate"), same_participant(R, _, E2).
needs(Q, "registration_submitted") :-
    asks(Q, R, "duplicate"), !log_event(_, R, "registration_submitted", _).

// --- type 4: expired deadline, payment attempted after the due time (#19) ---------
// A rejected transfer after the due time plus the grace period (policy value) is the bank
// doing its job. The latest due time counts (an extended deadline supersedes the old one).
// An attempt the bank accepted is never "expired", whatever its time.
.decl expired_attempt(q: symbol, due: symbol, attempt: symbol)
expired_attempt(Q, D, A) :-
    asks(Q, R, "deadline"),
    log_event(D, R, "payment_due", TD), !superseded(D),
    log_event(A, R, "payment_attempt", TA), log_attr(A, "result", "rejected"),
    triage_policy("grace_minutes", G), TA > TD + G * 60.
cause(Q, "expired", D) :- expired_attempt(Q, D, _).
cause(Q, "expired", A) :- expired_attempt(Q, _, A).
needs(Q, "payment_due") :- asks(Q, R, "deadline"), !log_event(_, R, "payment_due", _).
needs(Q, "payment_attempt") :- asks(Q, R, "deadline"), !log_event(_, R, "payment_attempt", _).

// --- type 5: suspected bug, an invariant the rules cannot explain (#20) ------------
// Fires for any in-scope question about the registration, whatever the topic: a person
// must look. Evidence is the violated invariant's name (the harness renders `rule/<name>`).
// A confirmed registration in a triage scenario therefore needs a `payment_received` log.
.decl invariant_violated(reg: symbol, invariant: symbol)
invariant_violated(R, "confirmed_without_payment") :-
    confirmed(R), !log_event(_, R, "payment_received", _).
invariant_violated(R, "confirmed_after_expiry") :-
    confirmed(R),
    log_event(D, R, "payment_due", TD), !superseded(D),
    log_event(P, R, "payment_received", TP),
    triage_policy("grace_minutes", G), TP > TD + G * 60.
invariant_violated(R, "over_capacity") :-
    registration(R, S), confirmed(R), attendee(R, A), attendee_attr(A, D, V),
    over_capacity(S, D, V, _).
cause(Q, "suspected_bug", I) :- subject(Q, R), in_scope(Q), invariant_violated(R, I).

// --- type 6: seat inquiry, answered from module ② (#21) --------------------------
// "Why is the women's quota full?": the question names a session and an attribute value;
// module ②'s `full` / `over_capacity` is the answer and the evidence.
.decl seat_question(q: symbol, session: symbol, dim: symbol, value: symbol)
seat_question(Q, S, D, V) :- asks_about(Q, "seat"), about_session(Q, S), about_value(Q, D, V).
cause(Q, "seat_full", "full") :- seat_question(Q, S, D, V), full(S, D, V), !over_capacity(S, D, V, _).
cause(Q, "over_capacity", "over_capacity") :- seat_question(Q, S, D, V), over_capacity(S, D, V, _).
needs(Q, "session") :- asks_about(Q, "seat"), !about_session(Q, _).
needs(Q, "attribute_value") :- asks_about(Q, "seat"), !about_value(Q, _, _).
// A value without a target has no quota to be full: the policy must say first.
needs(Q, "target") :- seat_question(Q, S, D, V), !target(S, D, V, _, _).
